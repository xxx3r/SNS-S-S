{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sns-s-s.local/schemas/governance-delegation.schema.json",
  "title": "SNS fast-governance delegation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "delegation_id",
    "period",
    "authority",
    "authorized_loop",
    "allowed_action_types",
    "allowed_quest_ids",
    "authorized_implementation_surfaces",
    "forbidden_surfaces",
    "max_authorizations_per_run",
    "max_pull_requests_per_authorization",
    "max_run_receipts_per_authorization",
    "required_checks",
    "recorded_at",
    "expires_at",
    "rationale"
  ],
  "properties": {
    "schema": {"const": "sns.governance-delegation.v1"},
    "delegation_id": {"type": "string", "pattern": "^DELEG-[A-Z0-9-]+$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "authority": {"enum": ["monthly-governance", "explicit-human"]},
    "authorized_loop": {"const": "daily-governance-triage"},
    "allowed_action_types": {"const": ["refine_existing"]},
    "allowed_quest_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^QST-[A-Z0-9]+-[0-9]{4}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "authorized_implementation_surfaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "forbidden_surfaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "max_authorizations_per_run": {"type": "integer", "minimum": 1, "maximum": 8},
    "max_pull_requests_per_authorization": {"const": 1},
    "max_run_receipts_per_authorization": {"const": 1},
    "required_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1}
  }
}
