{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sns-s-s.local/schemas/research-graph.schema.json",
  "title": "SNS typed research graph",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "nodes", "edges"],
  "properties": {
    "schema": {"const": "sns.research-graph.v1"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["research_quest", "research_infrastructure", "public_synthesis", "route", "experiment", "artifact", "evidence"]},
          "status": {"enum": ["active", "ready", "blocked", "proposed", "completed", "falsified", "superseded"]},
          "priority": {"type": "string", "pattern": "^P[0-9]+$"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "type": {"enum": ["contains", "requires", "informs", "unlocks", "falsifies", "competes_with", "supports", "supersedes", "revisit_after"]},
          "note": {"type": "string"}
        }
      }
    }
  }
}
