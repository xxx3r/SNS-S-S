{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sns-s-s.local/schemas/evidence-event.schema.json",
  "title": "SNS normalized evidence event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "evidence_id", "claim_cluster_id", "claim", "source_uri",
    "source_kind", "source_fingerprint", "observed_at", "independence",
    "polarity", "confidence", "provenance"
  ],
  "properties": {
    "schema": {"const": "sns.evidence-event.v1"},
    "evidence_id": {"type": "string", "pattern": "^EVID-"},
    "claim_cluster_id": {"type": "string", "pattern": "^CLM-"},
    "claim": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["primary_paper", "primary_report", "dataset", "official_statement", "secondary_report", "experiment", "simulation"]},
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "independence": {"enum": ["independent", "shared_origin", "unknown"]},
    "polarity": {"enum": ["supports", "weakens", "falsifies", "context_only"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "object", "minProperties": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}}
  }
}
